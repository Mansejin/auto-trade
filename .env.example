# 기본은 모의. 실주문은 PAPER=false + 키 + LIVE_CONFIRM 필요
PAPER=true
STRATEGY_PATH=/app/strategies/sma_cross_btc.json
STATE_PATH=/app/data/state.json
LOG_DIR=/app/logs
POLL_SECONDS=300
PAPER_CASH=1000000
FEE_RATE=0.0005
LOG_LEVEL=INFO

# 주문 비중 (0~1]. LIVE 권장: 0.5
ORDER_FRACTION=1.0
# 1회 최대 주문 금액(원). LIVE 권장: 10000. 0=제한 없음
MAX_ORDER_KRW=0
# 일일 손실 한도(원). 초과 시 신규 매수 중단. 0=비활성
MAX_DAILY_LOSS_KRW=0
# 연속 틱 오류 N회 시 주문 전면 중단. 0=비활성
MAX_CONSECUTIVE_ERRORS=5

# LIVE only
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
LIVE_CONFIRM=

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Desk dashboard (http://HOST:8080) — required, fail-closed if empty
# Generate: openssl rand -hex 32  (minimum 32 characters)
DASHBOARD_TOKEN=
# Public path prefix (mansejin.com/autotrade). Empty = root only.
BASE_PATH=/autotrade
