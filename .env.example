# 기본은 모의. 실주문은 PAPER=false + 키 + LIVE_CONFIRM 필요
PAPER=true
STRATEGY_PATH=/app/strategies/sma_cross_btc.json
STATE_PATH=/app/data/state.json
LOG_DIR=/app/logs
POLL_SECONDS=300
PAPER_CASH=1000000
FEE_RATE=0.0005
LOG_LEVEL=INFO

# 주문 비중 (0~1]. LIVE 권장: 0.5
ORDER_FRACTION=1.0
# 1회 최대 주문 금액(원). LIVE 권장: 10000. 0=제한 없음
MAX_ORDER_KRW=0
# 일일 손실 한도(원). 초과 시 신규 매수 중단. 0=비활성
MAX_DAILY_LOSS_KRW=0
# 연속 틱 오류 N회 시 주문 전면 중단. 0=비활성
MAX_CONSECUTIVE_ERRORS=5

# LIVE only
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
LIVE_CONFIRM=

# Bitget UTA (HMAC) — futures bot + optional transfers
# Docs: https://www.bitget.com/api-doc/uta/intro
# Agent Hub: https://github.com/Bitget-AI/agent_hub
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# UTA category (alias: BITGET_PRODUCT_TYPE)
BITGET_CATEGORY=USDT-FUTURES
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_MODE=isolated
BITGET_MARGIN_COIN=USDT
# Demo Trading header (paptrading:1). Needs Demo API keys; mutually exclusive with live.
BITGET_PAPER_TRADING=false
# Parallel container defaults (docker compose service bot-bitget)
BITGET_PAPER=true
BITGET_STRATEGY_PATH=/app/strategies/bitget_btc_usdt_sma.json
BITGET_MAX_ORDER_USDT=50
BITGET_ORDER_FRACTION=0.2

# Which exchange the primary `bot` service uses
EXCHANGE=upbit

# Semi-auto (Telegram) + strategy auto-fund (Upbit→Bitget on futures entry). Default OFF.
# Requires withdraw permission on API keys + IP whitelist.
TRANSFER_ENABLED=false
TRANSFER_CONFIRM=
TRANSFER_MAX_AMOUNT=50
TRANSFER_TTL_SEC=600
TRANSFER_DEFAULT_CHAIN=TRC20
TRANSFER_COOLDOWN_SEC=1800
# Auto fund bridge: Upbit KRW→TRX → Bitget TRX→USDT (UTA shared with futures).
# TRANSFER_MAX_AMOUNT = max withdraw size in coin units (TRX qty or USDT qty).
# Bitget Tron deposit address (USDT TRC20 / native TRX share the same address) —
# TRX withdraws reuse TRANSFER_WHITELIST_BITGET_USDT if TRX key is unset.
# TRANSFER_WHITELIST_BITGET_USDT=
# TRANSFER_WHITELIST_BITGET_TRX=
# TRANSFER_WHITELIST_UPBIT_USDT=
# TRANSFER_WHITELIST_UPBIT_TRX=

# Hybrid 50:50 treasury (alert → /리밸런스승인). Default OFF.
REBALANCE_ENABLED=false
REBALANCE_TARGET=0.5
REBALANCE_BAND=0.12
REBALANCE_ALERT_COOLDOWN_SEC=3600
REBALANCE_MIN_MOVE_KRW=50000

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Primary bot listens for commands; bot-bitget should stay false
TELEGRAM_COMMANDS=true

# Desk dashboard (http://HOST:8080) — required, fail-closed if empty
# Generate: openssl rand -hex 32  (minimum 32 characters)
DASHBOARD_TOKEN=
# Public path prefix (mansejin.com/autotrade). Empty = root only.
BASE_PATH=/autotrade
